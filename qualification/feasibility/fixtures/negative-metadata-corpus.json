      "reason": "unclassified channel is non-admissible, not extensible"
    },
    {
      "id": "POS-MECHANICAL-01",
      "channel": "mechanical_only",
      "record": {
        "assignment_id": "unit-007",
        "claim_generation": 0,
        "attempt_nonce_id": "0123456789abcdef0123456789abcdef",
        "commit": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "output_path": "results/unit-007.json",
        "receipt_state": "COMPLETE",
        "readback": "VERIFIED"
      },
      "expect": "ADMISSIBLE",
