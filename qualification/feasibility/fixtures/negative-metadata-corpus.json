      "expect": "REJECTED",
      "reason": "commit message matches semantic pattern (critical/blocking/finding)"
    },
    {
      "id": "NEG-PATH-01",
      "channel": "output_path",
      "record": { "assignment_id": "unit-003", "output_path": "results/RED-critical-unit-003.json" },
      "expect": "REJECTED",
      "reason": "output name carries semantic path tokens RED/critical"
    },
    {
      "id": "NEG-PROVENANCE-01",
      "channel": "provenance_field",
      "record": { "assignment_id": "unit-004", "claim_generation": 0, "finding": "synthetic blocker syn-001" },
      "expect": "REJECTED",
      "reason": "provenance field carries semantic key 'finding'"
    },
    {
      "id": "NEG-RECEIPT-01",
      "channel": "receipt_value",
      "record": { "assignment_id": "unit-005", "receipt_state": "COMPLETE", "verdict_text": "GREEN all clear" },
      "expect": "REJECTED",
      "reason": "receipt carries free-form semantic verdict"
    },
    {
      "id": "NEG-UNKNOWN-CHANNEL-01",
      "channel": "unknown_field",
      "record": { "assignment_id": "unit-006", "exotic_channel": "synthetic" },
