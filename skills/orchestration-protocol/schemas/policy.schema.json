{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:op-skill:schema:v1:policy",
  "title": "OP v1 compatibility, current-policy, qualification-impact, detached qualification records",
  "version": "1.0.0",
  "normative_owner": "contracts-and-versioning",
  "description": "Distribution-policy authority (proposed construction data distinguished from authorized current readback), compatibility manifest, qualification-impact manifest with conservative dependency mapping, and detached qualification records (PASS/FAIL/BLOCKED only).",
  "defs": {
    "compatibility_manifest": {
      "type": "object",
      "required": ["manifest_id", "release_id", "op_contract", "profiles", "result_schema", "references", "templates_digest"],
      "properties": {
        "manifest_id": { "type": "string", "minLength": 1 },
        "release_id": { "type": "string", "minLength": 1 },
        "op_contract": { "type": "string", "minLength": 1 },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["profile_id", "semantics_version", "status"],
            "properties": {
              "profile_id": { "type": "string", "minLength": 1 },
              "semantics_version": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["implemented", "pending"] }
            },
            "additionalProperties": false
          }
        },
        "result_schema": { "type": "string", "minLength": 1 },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["owner_id", "version", "status"],
            "properties": {
              "owner_id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["implemented", "pending"] }
            },
            "additionalProperties": false
          }
        },
        "helper_api": { "type": ["string", "null"] },
        "templates_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "current_policy": {
      "type": "object",
      "required": ["policy_id", "policy_version", "policy_kind", "minimum_supported_release", "revoked_releases", "freshness_rule", "required_readback", "production_admission_eligible"],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "policy_version": { "type": "string", "minLength": 1 },
        "policy_kind": { "type": "string", "enum": ["proposed-construction", "authorized-current-readback"] },
        "minimum_supported_release": { "type": "string", "minLength": 1 },
        "revoked_releases": { "type": "array", "items": { "type": "string" } },
        "supersession": { "type": ["object", "null"] },
        "freshness_rule": { "type": "string", "minLength": 1 },
        "required_readback": {
          "type": "object",
          "required": ["distribution_authority", "freshness_inputs"],
          "properties": {
            "distribution_authority": { "type": "string", "minLength": 1 },
            "freshness_inputs": {
              "type": "object",
              "required": ["issued_at", "max_age_days"],
              "properties": {
                "issued_at": { "type": "string", "minLength": 1 },
                "max_age_days": { "type": "integer", "minimum": 1 },
                "successor_pointer": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "production_admission_eligible": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "qualification_impact": {
      "type": "object",
      "required": ["manifest_id", "release_id", "inventory", "change_classes"],
      "properties": {
        "manifest_id": { "type": "string", "minLength": 1 },
        "release_id": { "type": "string", "minLength": 1 },
        "inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["component", "identity"],
            "properties": {
              "component": { "type": "string", "minLength": 1 },
              "identity": {
                "anyOf": [
                  { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  {
                    "type": "object",
                    "required": ["unavailable", "observation"],
                    "properties": {
                      "unavailable": { "type": "boolean", "const": true },
                      "observation": { "type": "string", "minLength": 1 }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "change_classes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["change_class", "invalidates"],
            "properties": {
              "change_class": { "type": "string", "minLength": 1 },
              "invalidates": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "enum": ["Q0", "Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7", "Q8", "Q9", "Q10"] }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "qualification_record": {
      "type": "object",
      "required": ["record_id", "candidate_id", "layer", "verdict", "fixture_set", "evidence_locator"],
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "candidate_id": { "type": "string", "minLength": 1 },
        "fixture_set": { "type": "string", "minLength": 1 },
        "probe_set": { "type": ["string", "null"] },
        "layer": { "type": "string", "enum": ["Q0", "Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7", "Q8", "Q9", "Q10"] },
        "verdict": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
        "evidence_locator": { "type": "string", "minLength": 1 },
        "owner_disposition": { "type": ["string", "null"], "enum": ["ACCEPTABLE", "UNACCEPTABLE", "UNKNOWN", null] }
      },
      "additionalProperties": false
    }
  }
}
