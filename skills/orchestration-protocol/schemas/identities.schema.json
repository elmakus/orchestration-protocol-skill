{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:op-skill:schema:v1:identities",
  "title": "OP v1 immutable subject/coverage identities",
  "version": "1.0.0",
  "normative_owner": "contracts-and-versioning",
  "description": "Versioned grammars for Git, captured-content, and composite manifest identities. Canonical serialization/digest rules are owned by references/contracts-and-versioning.md section 3.",
  "defs": {
    "git_identity": {
      "type": "object",
      "required": ["identity_class", "repository", "commit", "path", "blob"],
      "properties": {
        "identity_class": { "const": "git" },
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "type": "string", "minLength": 1 },
        "blob": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    },
    "captured_content_identity": {
      "type": "object",
      "required": ["identity_class", "sha256", "byte_length", "capture_method"],
      "properties": {
        "identity_class": { "const": "captured-content" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byte_length": { "type": "integer", "minimum": 0 },
        "capture_method": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "composite_manifest": {
      "type": "object",
      "required": ["identity_class", "members", "composite_digest"],
      "properties": {
        "identity_class": { "const": "composite-manifest" },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              { "$ref": "#/defs/git_identity" },
              { "$ref": "#/defs/captured_content_identity" }
            ]
          }
        },
        "composite_digest": { "type": "string", "pattern": "^content:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "subject_identity": {
      "anyOf": [
        { "$ref": "#/defs/git_identity" },
        { "$ref": "#/defs/captured_content_identity" },
        { "$ref": "#/defs/composite_manifest" }
      ]
    }
  }
}
