{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:op-skill:schema:v1:metadata",
  "title": "OP v1 closed mechanical metadata, execution receipts, provider receipts",
  "version": "1.0.0",
  "normative_owner": "evidence-and-sources",
  "normative_co_owner": "security-and-effects",
  "description": "Closed coordinator-visible mechanical surface with typed value grammars, deterministic derivation/binding rules (evidence-and-sources section 6), and provider/tool receipt interfaces with closed postcondition forms. Any field outside this grammar, any value outside the typed value grammars, or any well-shaped but wrong-bound identifier is non-admissible pre-integration.",
  "defs": {
    "mechanical_metadata": {
      "type": "object",
      "required": ["assignment_id", "package_id", "release_id", "subject_digest", "coverage_digest"],
      "properties": {
        "assignment_id": { "type": "string", "pattern": "^assign:[0-9]{4}$" },
        "unit_id": { "type": ["string", "null"], "pattern": "^unit-[0-9]{2}$" },
        "run_id": { "type": ["string", "null"], "pattern": "^RUN-[0-9]{3}$" },
        "package_id": { "type": "string", "minLength": 1 },
        "release_id": { "type": "string", "minLength": 1 },
        "subject_digest": { "type": "string", "pattern": "^(runenv|content|sha256):[0-9a-f]{64}$" },
        "coverage_digest": { "type": "string", "pattern": "^(runenv|content|sha256):[0-9a-f]{64}$" },
        "claim_generation": { "type": ["integer", "null"], "minimum": 0 },
        "attempt_nonce_id": { "type": ["string", "null"], "pattern": "^nonce:[0-9]{4}$" },
        "branch": { "type": ["string", "null"], "pattern": "^op/[A-Za-z0-9-]+/[A-Za-z0-9-]+$" },
        "ref": { "type": ["string", "null"], "pattern": "^refs/heads/op/[A-Za-z0-9-]+/[A-Za-z0-9-]+$" },
        "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "blob": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "output_path": { "type": ["string", "null"], "pattern": "^results/[A-Za-z0-9-]+\\.md$" },
        "publication": { "type": ["string", "null"], "pattern": "^[^@\\s]+@[0-9a-f]{40}:results/[A-Za-z0-9-]+\\.md$" },
        "readback": { "type": ["string", "null"], "enum": ["VERIFIED", "NOT_APPLICABLE", null] },
        "ancestry": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "expected_head": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    },
    "execution_receipt": {
      "type": "object",
      "required": ["assignment_id", "status", "durable_result", "readback"],
      "properties": {
        "assignment_id": { "type": "string", "pattern": "^assign:[0-9]{4}$" },
        "status": { "type": "string", "enum": ["COMPLETE", "BLOCKED", "EXHAUSTED"] },
        "durable_result": { "type": "string", "pattern": "^[^@\\s]+@[0-9a-f]{40}:results/[A-Za-z0-9-]+\\.md$" },
        "readback": { "type": "string", "enum": ["VERIFIED", "NOT_APPLICABLE"] },
        "blocker": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "enum": ["none", "missing:authority", "missing:evidence", "missing:provider-read", "missing:claim", "missing:generation", "unavailable:helper", "unavailable:native", "conflict:state", "conflict:binding"] }
          ]
        }
      },
      "additionalProperties": false
    },
    "provider_receipt": {
      "type": "object",
      "required": ["operation_id", "target", "occurrence", "postcondition", "readback"],
      "properties": {
        "operation_id": { "type": "string", "pattern": "^op:[0-9]{4}$" },
        "target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+:refs/heads/\\S+$" },
        "expected_head": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "occurrence": { "type": "string", "enum": ["VERIFIED", "NOT_APPLIED", "UNKNOWN"] },
        "postcondition": { "type": "string", "pattern": "^(ref-points-at:[0-9a-f]{40}|no-write-performed|path-content-matches:[0-9a-f]{64})$" },
        "readback": { "type": "string", "enum": ["VERIFIED", "NOT_APPLICABLE"] }
      },
      "additionalProperties": false
    }
  }
}
