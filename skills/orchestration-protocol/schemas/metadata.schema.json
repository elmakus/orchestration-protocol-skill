{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:op-skill:schema:v1:metadata",
  "title": "OP v1 closed mechanical metadata, execution receipts, provider receipts",
  "version": "1.0.0",
  "normative_owner": "evidence-and-sources",
  "normative_co_owner": "security-and-effects",
  "description": "Closed coordinator-visible mechanical surface with typed value grammars plus provider/tool receipt interfaces. Any field outside this grammar, or any value outside the typed value grammars, is non-admissible pre-integration.",
  "defs": {
    "mechanical_metadata": {
      "type": "object",
      "required": ["assignment_id", "package_id", "release_id", "subject_digest", "coverage_digest"],
      "properties": {
        "assignment_id": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,128}$" },
        "unit_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9:_-]{1,128}$" },
        "run_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9:_-]{1,128}$" },
        "package_id": { "type": "string", "minLength": 1 },
        "release_id": { "type": "string", "minLength": 1 },
        "subject_digest": { "type": "string", "minLength": 1 },
        "coverage_digest": { "type": "string", "minLength": 1 },
        "claim_generation": { "type": ["integer", "null"], "minimum": 0 },
        "attempt_nonce_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9:_-]{1,128}$" },
        "branch": { "type": ["string", "null"], "pattern": "^op/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" },
        "ref": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9/_.-]{1,256}$" },
        "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "blob": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "output_path": { "type": ["string", "null"], "pattern": "^results/[a-z0-9][a-z0-9_.-]*\\.md$" },
        "publication": { "type": ["string", "null"], "pattern": "^[^@\\s]+@[0-9a-f]{40}:\\S+$" },
        "readback": { "type": ["string", "null"], "enum": ["VERIFIED", "NOT_APPLICABLE", null] },
        "ancestry": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9:_-]{1,128}$" },
        "expected_head": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    },
    "execution_receipt": {
      "type": "object",
      "required": ["assignment_id", "status", "durable_result", "readback"],
      "properties": {
        "assignment_id": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,128}$" },
        "status": { "type": "string", "enum": ["COMPLETE", "BLOCKED", "EXHAUSTED"] },
        "durable_result": { "type": "string", "pattern": "^[^@\\s]+@[0-9a-f]{40}:\\S+$" },
        "readback": { "type": "string", "enum": ["VERIFIED", "NOT_APPLICABLE"] },
        "blocker": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^(none|[a-z0-9]+:[a-z0-9-]+)$" }
          ]
        }
      },
      "additionalProperties": false
    },
    "provider_receipt": {
      "type": "object",
      "required": ["operation_id", "target", "occurrence", "postcondition", "readback"],
      "properties": {
        "operation_id": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,128}$" },
        "target": { "type": "string", "minLength": 1 },
        "expected_head": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "occurrence": { "type": "string", "enum": ["VERIFIED", "NOT_APPLIED", "UNKNOWN"] },
        "postcondition": { "type": "string", "minLength": 1 },
        "readback": { "type": "string", "enum": ["VERIFIED", "NOT_APPLICABLE"] }
      },
      "additionalProperties": false
    }
  }
}
